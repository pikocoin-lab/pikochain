# Your Base receiving address (PUBLIC — this is where buyers' USDC goes).
# Replace with any address you control if you want earnings elsewhere.
BASE_PAY_TO=0x3BD7d1505Ea03D1483044287f2246FF68231B277

# Price per call, in USDC atomic units (6 decimals). 10000 = $0.01
BASE_PRICE=10000

# Facilitator that verifies + settles payments (no auth needed).
# Verified 2026-09-25: supports "base" (mainnet) and "base-sepolia" (testnet)
# with the v1 envelope. Do NOT use eip155:8453-style ids here — this
# facilitator has no settlement backend registered for them.
BASE_FACILITATOR_URL=https://facilitator.xpay.sh

# "base" = mainnet (real USDC). "base-sepolia" = testnet (free test USDC).
# ALWAYS test on base-sepolia first.
BASE_NETWORK=base-sepolia

PORT=8092
