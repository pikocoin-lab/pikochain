#!/usr/bin/env node
/*
 * base-seller — sell a paid API on Base mainnet, earn real USDC per call (x402).
 *
 *   BASE_PAY_TO=0x...      your Base receiving address (REQUIRED; falls back to
 *                          the documented default below — change it to your own)
 *   BASE_PRICE=10000       price per call in USDC atomic units (6 decimals; default $0.01)
 *   BASE_FACILITATOR_URL   default https://facilitator.xpay.sh
 *   BASE_NETWORK           default "base" (use "base-sepolia" for testnet-first runs)
 *   BASE_PUBLIC_URL        public base URL for 402 `resource` fields
 *                          (e.g. https://pikobase.serveousercontent.com)
 *   PORT                   default 8092
 *
 * Needs the `ethers` package: run `npm i ethers` in this skill dir, or set
 * NODE_PATH to a dir that has it.
 *
 * Flow per request: no/invalid X-PAYMENT -> HTTP 402 with paymentRequirements.
 * Valid payment -> facilitator /verify -> run handler -> facilitator /settle ->
 * return result. The result is NEVER returned when payment fails.
 */
'use strict';
let ethers;
try { ethers = require('ethers'); }
catch (e) {
  console.error('missing dependency: ethers. Run `npm i ethers` in the skill dir first.');
  process.exit(1);
}
const http = require('http');

// Verified on-chain (Base mainnet, chainId 8453): name()="USD Coin", version()="2", decimals()=6
const USDC_MAINNET = '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913';
const USDC_SEPOLIA  = '0x036CbD53842c5426634e7929541eC2318f3dCF7e';
const TOKEN_NAME = 'USD Coin';
const TOKEN_VERSION = '2';

// Default receiving address (documented; override with BASE_PAY_TO).
// This is a PUBLIC receiving address, not a key.
const DEFAULT_PAY_TO = '0x3BD7d1505Ea03D1483044287f2246FF68231B277';

const CFG = {
  payTo: process.env.BASE_PAY_TO || DEFAULT_PAY_TO,
  price: process.env.BASE_PRICE || '10000',
  facilitator: (process.env.BASE_FACILITATOR_URL || 'https://facilitator.xpay.sh').replace(/\/+$/, ''),
  network: process.env.BASE_NETWORK || 'base',
  port: parseInt(process.env.PORT || '8092', 10),
  // Public base URL for the `resource` field in 402 quotes (e.g. the serveo
  // tunnel URL). Falls back to the local address when unset.
  publicUrl: (process.env.BASE_PUBLIC_URL || '').replace(/\/+$/, ''),
};
if (!ethers.isAddress(CFG.payTo)) {
  console.error('BASE_PAY_TO is not a valid address:', CFG.payTo);
  process.exit(1);
}
const ASSET = CFG.network === 'base-sepolia' ? USDC_SEPOLIA : USDC_MAINNET;

const trunc = (a) => (typeof a === 'string' && a.length > 12 ? a.slice(0, 6) + '…' + a.slice(-4) : a);

/* ---------------- Energy accounting: kWh disclosure (v0.1) ---------------- */
// "Butter-robot accounting": every quote (402 / ?quote=1) and every paid result
// carries an energy-cost estimate, so buyers see kWh alongside USDC.
// This is the protocol field that matters; the coefficients are v0.1
// placeholders pending real power metering.
//
// Method (documented, honest): measure handler elapsed milliseconds, multiply
// by an assumed power draw for this request's CPU share, add a per-byte
// network term. This is an ESTIMATE — no power meter is attached to this box.
// For I/O-bound handlers (extract/edgar) elapsed time includes waiting, so the
// 15 W assumption overestimates; that bias is disclosed, not hidden.
const ENERGY = {
  method: 'elapsed_ms × assumed power draw + network bytes (estimate v0.1, not metered)',
  wattsAssumed: 15,          // assumed W for this request's share while running
  whPerByteNetwork: 2e-7,    // ~0.2 µWh per byte transferred (placeholder)
};
function estimateEnergyKwh({ elapsedMs = 0, bytesIn = 0, bytesOut = 0 } = {}) {
  const joulesCompute = (elapsedMs / 1000) * ENERGY.wattsAssumed;
  const whNetwork = (bytesIn + bytesOut) * ENERGY.whPerByteNetwork;
  const kwh = joulesCompute / 3.6e6 + whNetwork / 1000;
  return {
    kwh_estimate: kwh,
    kwh_human: kwh < 1e-6 ? `${(kwh * 1e9).toFixed(1)} nWh`
      : kwh < 1e-3 ? `${(kwh * 1e6).toFixed(2)} µWh`
      : `${(kwh * 1e3).toFixed(3)} mWh`,
    method: ENERGY.method,
    inputs: {
      elapsed_ms: Math.round(elapsedMs * 100) / 100,
      bytes_in: bytesIn,
      bytes_out: bytesOut,
    },
    disclaimer: 'estimate only — no power meter attached; v0.1 placeholder coefficients',
  };
}
// Typical per-call estimate shown on quotes (before input is known).
function typicalEnergy(product) {
  return estimateEnergyKwh({
    elapsedMs: product.typicalElapsedMs || 5,
    bytesIn: 1024,
    bytesOut: 1024,
  });
}

/* ---------------- example product: /text-stats ---------------- */
function detectLanguage(text) {
  // heuristic only — script detection, not real language ID
  if (/[\u3040-\u30ff]/.test(text)) return 'ja';
  if (/[\uac00-\ud7af]/.test(text)) return 'ko';
  if (/[\u4e00-\u9fff]/.test(text)) return 'zh';
  if (/[\u0400-\u04ff]/.test(text)) return 'ru';
  if (/[\u0600-\u06ff]/.test(text)) return 'ar';
  if (/[a-zA-Z]/.test(text)) return 'en';
  return 'unknown';
}
function textStats(input) {
  const text = typeof input === 'string' ? input : String((input && input.text) || '');
  const chars = [...text].length;
  const charsNoSpaces = [...text].filter((c) => !/\s/.test(c)).length;
  const words = (text.trim().match(/\S+/g) || []).length;
  return {
    words,
    characters: chars,
    charactersNoSpaces: charsNoSpaces,
    readingTimeMinutes: Math.round((words / 200) * 100) / 100,
    detectedLanguage: detectLanguage(text),
    languageNote: 'detectedLanguage is a script heuristic, not certified language ID',
  };
}
/* ---------------- end example product ---------------- */

/* ---------------- /translate ($0.02, demo dictionary) ---------------- */
const DEMO_DICT = {
  'hello': '你好', 'world': '世界', 'good': '好', 'morning': '早上',
  'thank': '谢谢', 'you': '你', 'love': '爱', 'peace': '和平',
};
function translateDemo(input) {
  const text = String((input && input.text) || '');
  const target = String((input && input.target) || 'zh');
  const words = text.toLowerCase().split(/\s+/).map((w) => DEMO_DICT[w] || w);
  return {
    translated: words.join(' '),
    target,
    note: 'demo dictionary translation, not production MT',
  };
}
/* ---------------- /extract ($0.01, SSRF-guarded) ---------------- */
const dns = require('dns').promises;
function isPrivateIP(ip) {
  return /^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|0\.0\.0\.0|::1|fe80:)/i.test(ip);
}
async function extractUrl(input) {
  const urlStr = String((input && input.url) || '');
  let u;
  try { u = new URL(urlStr); } catch { throw new Error('invalid url'); }
  if (!/^https?:$/.test(u.protocol)) throw new Error('only http/https allowed');
  // SSRF guard: resolve and block private/loopback IPs
  let addrs;
  try { addrs = await dns.lookup(u.hostname, { all: true }); }
  catch { throw new Error('dns resolution failed'); }
  for (const a of addrs) {
    if (isPrivateIP(a.address)) throw new Error('private network blocked (SSRF guard)');
  }
  const ctl = new AbortController();
  const t = setTimeout(() => ctl.abort(), 12000);
  try {
    const r = await fetch(u.toString(), {
      signal: ctl.signal,
      headers: { 'User-Agent': 'pikobase-extract/1.0' },
      redirect: 'manual',
    });
    // re-check redirects
    if ([301, 302, 303, 307, 308].includes(r.status)) {
      const loc = r.headers.get('location');
      if (loc) {
        const ru = new URL(loc, u);
        const raddrs = await dns.lookup(ru.hostname, { all: true }).catch(() => []);
        for (const a of raddrs) {
          if (isPrivateIP(a.address)) throw new Error('redirect to private network blocked');
        }
      }
      throw new Error('redirects not followed for safety');
    }
    const ct = r.headers.get('content-type') || '';
    const buf = Buffer.from(await r.arrayBuffer());
    if (buf.length > 2e6) throw new Error('response too large (2MB cap)');
    const html = buf.toString('utf8');
    const title = (html.match(/<title[^>]*>([^<]*)<\/title>/i) || [])[1] || '';
    const text = html.replace(/<script[\s\S]*?<\/script>/gi, ' ')
      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
      .replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 5000);
    return { url: u.toString(), status: r.status, contentType: ct, title: title.trim(), text };
  } finally { clearTimeout(t); }
}
/* ---------------- /edgar ($0.05, SEC filings) ---------------- */
let edgarMod = null;
function getEdgar() {
  if (!edgarMod) {
    try { edgarMod = require('/home/hatch/workspace/my-chain/x402/scripts/edgar.js'); }
    catch (e) { edgarMod = { error: 'edgar module unavailable: ' + e.message }; }
  }
  return edgarMod;
}
async function edgarHandler(input) {
  const mod = getEdgar();
  if (mod.error) throw new Error(mod.error);
  const ticker = String((input && (input.ticker || input.cik)) || '').toUpperCase();
  if (!ticker) throw new Error('ticker or cik required');
  // edgar.js exports a function; adapt to its interface
  const fn = mod.getEdgarData || mod.default || mod;
  if (typeof fn !== 'function') throw new Error('edgar module has no callable export');
  return fn(ticker);
}
/* ---------------- /insight ($0.01, text insight) ---------------- */
function textInsight(input) {
  const text = String((input && input.text) || '');
  const stats = textStats(text);
  const sentences = (text.match(/[^.!?]+[.!?]+/g) || []).length;
  const paras = (text.split(/\n\s*\n/) || []).filter((p) => p.trim()).length;
  const uniqueWords = new Set((text.toLowerCase().match(/\S+/g) || [])).size;
  return {
    ...stats,
    sentences,
    paragraphs: paras,
    uniqueWords,
    lexicalDiversity: stats.words ? Math.round((uniqueWords / stats.words) * 100) / 100 : 0,
  };
}

const PRODUCTS = {
  '/text-stats': {
    description: 'Text statistics: word/character counts, reading time, script-based language hint. $0.01 per call.',
    price: CFG.price,
    typicalElapsedMs: 5,
    handler: async (body) => textStats(body),
  },
  '/translate': {
    description: 'Demo dictionary translation (EN->ZH). $0.02 per call.',
    price: '20000',
    typicalElapsedMs: 3,
    handler: async (body) => translateDemo(body),
  },
  '/extract': {
    description: 'Fetch a URL and return title + text (SSRF-guarded, 2MB cap). $0.01 per call.',
    price: '10000',
    typicalElapsedMs: 800,
    handler: async (body) => extractUrl(body),
  },
  '/edgar': {
    description: 'SEC EDGAR company filings + key financials by ticker. $0.05 per call.',
    price: '50000',
    typicalElapsedMs: 1500,
    handler: async (body) => edgarHandler(body),
  },
  '/insight': {
    description: 'Deeper text insight: sentences, paragraphs, lexical diversity. $0.01 per call.',
    price: '10000',
    typicalElapsedMs: 8,
    handler: async (body) => textInsight(body),
  },
};

function payRequirements(route, product) {
  return {
    scheme: 'exact',
    network: CFG.network,
    maxAmountRequired: product.price,
    resource: (CFG.publicUrl || `http://localhost:${CFG.port}`) + route,
    description: product.description,
    mimeType: 'application/json',
    payTo: CFG.payTo,
    maxTimeoutSeconds: 300,
    asset: ASSET,
    // xpay.sh requires the EIP-712 domain here (verified live: without it -> missing_eip712_domain)
    extra: { name: TOKEN_NAME, version: TOKEN_VERSION },
  };
}
function send402(res, route, product) {
  const requirements = payRequirements(route, product);
  const body = {
    x402Version: 1,
    error: `Payment required: ${product.description}`,
    accepts: [requirements],
    // Energy disclosure: informational only, NOT part of paymentRequirements
    // (the settlement path via the facilitator is untouched).
    energy: typicalEnergy(product),
  };
  res.writeHead(402, {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, X-PAYMENT',
    'Content-Type': 'application/json',
    // x402 spec: machine-readable requirements in the PAYMENT-REQUIRED header
    'PAYMENT-REQUIRED': Buffer.from(JSON.stringify(requirements)).toString('base64'),
  });
  res.end(JSON.stringify(body));
}
function parseXPayment(req) {
  const h = req.headers['x-payment'];
  if (!h) return null;
  try {
    const raw = h.startsWith('{') ? h : Buffer.from(h, 'base64').toString('utf8');
    return JSON.parse(raw);
  } catch { return null; }
}
async function facilitator(path, body) {
  const r = await fetch(CFG.facilitator + path, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  return r.json();
}
function readBody(req) {
  return new Promise((resolve) => {
    let d = '';
    req.on('data', (c) => { d += c; if (d.length > 1e6) req.destroy(); });
    req.on('end', () => {
      const rawBytes = Buffer.byteLength(d);
      try { resolve({ body: JSON.parse(d || '{}'), rawBytes }); }
      catch { resolve({ body: {}, rawBytes }); }
    });
  });
}

function discoveryDoc() {
  const base = CFG.publicUrl.replace(/\/$/, '');
  return {
    x402Version: 1,
    name: 'pikobase',
    description: 'Paid micro-APIs on Base mainnet, settled in native USDC via x402 (EIP-3009, gasless for buyer).',
    facilitator: CFG.facilitator,
    endpoints: Object.entries(PRODUCTS).map(([path, p]) => ({
      path,
      url: base + path,
      method: 'POST',
      price: `$${(Number(p.price) / 1e6).toFixed(2)}`,
      network: CFG.network,
      asset: ASSET,
      payTo: CFG.payTo,
      description: p.description,
      energy_kwh_typical: typicalEnergy(p).kwh_estimate,
      energy_note: 'quotes and results also carry a per-call `energy` object (kWh estimate, v0.1)',
    })),
  };
}
const LLMS_TXT = `# pikobase — paid micro-APIs on Base mainnet

Pay per call in native USDC (6 decimals) via the x402 protocol. No API key, no account.
Buyer signs an EIP-3009 authorization (gasless — the facilitator submits it).

## How to call
1. GET https://pikobase.serveousercontent.com/text-stats?quote=1  → 200 with price quote (also returned as HTTP 402 on unpaid POST)
2. Sign EIP-3009 TransferWithAuthorization for the quoted amount (see quote.accept[0]: network, asset, payTo, maxAmountRequired, extra.name/version for the EIP-712 domain)
3. POST the endpoint with header X-PAYMENT: base64({"x402Version":1,"scheme":"exact","network":"base","payload":{"signature","authorization"}})
4. HTTP 200 + JSON result. Settlement tx hash returned in X-SUCCESS header.

## Endpoints
- POST /text-stats — $0.01/call. Input {"text":"..."}. Returns word/character counts, reading time, script-based language hint.
- POST /translate — $0.02/call. Input {"text":"hello","target":"zh"}. Demo dictionary translation.
- POST /extract — $0.01/call. Input {"url":"https://..."}. Returns title + text (SSRF-guarded).
- POST /edgar — $0.05/call. Input {"ticker":"AAPL"}. SEC EDGAR filings + key financials.
- POST /insight — $0.01/call. Input {"text":"..."}. Sentences, paragraphs, lexical diversity.

## Energy disclosure (kWh)
Every quote (HTTP 402 body, ?quote=1) and every paid result carries an "energy"
object: a per-call kWh estimate (method: elapsed_ms x assumed 15 W + network
bytes; v0.1 estimate, not a meter reading). Buyers see energy cost alongside
USDC price. Informational only — it is not part of the signed payment
requirements and never changes settlement.

## Discovery
- /.well-known/x402 (machine-readable)
- Facilitator: https://facilitator.xpay.sh
- Network: base (chain id 8453). Asset: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (native USDC)
`;

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, 'http://localhost');
  const route = url.pathname;
  // CORS: allow browser pages (e.g. the muse.ai self-buy page) to call us.
  // Payment auth travels in the signed X-PAYMENT payload, not cookies, so
  // a permissive origin is safe here.
  const cors = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, X-PAYMENT',
    'Access-Control-Expose-Headers': 'X-SUCCESS, X-TRANSACTION',
    'Access-Control-Max-Age': '86400',
  };
  if (req.method === 'OPTIONS') {
    res.writeHead(204, cors);
    res.end();
    return;
  }
  const withCors = (h) => Object.assign({}, cors, h);
  if (route === '/.well-known/x402' && req.method === 'GET') {
    res.writeHead(200, withCors({ 'Content-Type': 'application/json' }));
    res.end(JSON.stringify(discoveryDoc(), null, 2));
    return;
  }
  if (route === '/llms.txt' && req.method === 'GET') {
    res.writeHead(200, withCors({ 'Content-Type': 'text/plain; charset=utf-8' }));
    res.end(LLMS_TXT);
    return;
  }
  const product = PRODUCTS[route];
  if (!product) {
    res.writeHead(404, withCors({ 'Content-Type': 'application/json' }));
    res.end(JSON.stringify({ error: 'not found', products: Object.keys(PRODUCTS) }));
    return;
  }
  if (req.method === 'GET' && url.searchParams.get('quote') === '1') {
    res.writeHead(200, withCors({ 'Content-Type': 'application/json' }));
    res.end(JSON.stringify({ accepts: [payRequirements(route, product)], energy: typicalEnergy(product) }));
    return;
  }
  const paymentPayload = parseXPayment(req);
  const paymentRequirements = payRequirements(route, product);
  if (!paymentPayload) { send402(res, route, product); return; }
  try {
    const v = await facilitator('/verify', { paymentPayload, paymentRequirements });
    if (!v || v.isValid !== true) {
      console.log(`[verify-fail] ${new Date().toISOString()} ${route} reason=${v && (v.invalidReason || v.error)}`);
      send402(res, route, product); return;
    }
    const input = await readBody(req);
    const t0 = Date.now();
    const result = await product.handler(input.body);
    const elapsedMs = Date.now() - t0;
    const s = await facilitator('/settle', { paymentPayload, paymentRequirements });
    const tx = s && (s.transaction || s.txHash);
    if (!tx) {
      console.log(`[settle-fail] ${new Date().toISOString()} ${route} reason=${s && (s.errorReason || s.error || JSON.stringify(s)).toString().slice(0,200)}`);
      send402(res, route, product); return;
    }
    const payer = (paymentPayload.payload && paymentPayload.payload.authorization && paymentPayload.payload.authorization.from) || '?';
    const energy = estimateEnergyKwh({
      elapsedMs,
      bytesIn: input.rawBytes,
      bytesOut: Buffer.byteLength(JSON.stringify(result)),
    });
    console.log(`[paid] ${new Date().toISOString()} ${route} payer=${trunc(payer)} amount=${product.price} tx=${tx} energy=${energy.kwh_human}`);
    res.writeHead(200, withCors({ 'Content-Type': 'application/json' }));
    res.end(JSON.stringify({ result, settlement: { transaction: tx, network: CFG.network, payer }, energy }));
  } catch (e) {
    // never leak the result on any failure path
    console.log(`[error] ${new Date().toISOString()} ${route} ${e && e.message}`);
    send402(res, route, product);
  }
});

if (require.main === module) {
  server.listen(CFG.port, () =>
    console.log(`base-seller on :${CFG.port} | network=${CFG.network} | payTo=${trunc(CFG.payTo)} | price=${CFG.price} | facilitator=${CFG.facilitator}`)
  );
}
module.exports = { textStats, detectLanguage, payRequirements, CFG, PRODUCTS };
