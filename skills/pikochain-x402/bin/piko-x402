#!/usr/bin/env node
// piko-x402: CLI for AI agents to discover & pay for PikoChain services via x402.
// No API key, no account, no official integration: payment IS the access.
//   piko-x402 discover            # list on-chain services (endpoint + price)
//   piko-x402 price <url>         # show the 402 quote, pay nothing
//   piko-x402 pay <url>           # quote -> EIP-712 sign -> X-PAYMENT -> 200
//   piko-x402 bounty <address>    # claim $0.05 test wUSDC (one per address)
// Key: env PIKO_X402_KEY, or --key-file <path>, or --new-key (throwaway + auto-bounty).
// SECURITY: key material is never printed and never written to disk by this script.

const os = require('os');
const path = require('path');
const fs = require('fs');

let ethers;
try {
  ethers = require('ethers');
} catch {
  ethers = require(path.join(os.homedir(), 'workspace/my-chain/x402/node_modules/ethers'));
}

const GATEWAY = process.env.PIKO_X402_GATEWAY || 'https://pikochain.serveousercontent.com';
const RPC = process.env.PIKO_X402_RPC || 'http://127.0.0.1:8545';
const REGISTRY = '0x7aE738fA0652761cFd0347b8D387461877417a74';
const NETWORK = 'eip155:2049';
const CHAIN_ID = 2049;

// Service seeds known to have been registered in PikoPayRegistry (keccak256(seed) = id).
const KNOWN_SEEDS = [
  'pikopay-demo-insight',
  'pikopay-demo-upto-translate',
  'pikopay-demo-translate',
  'pikopay-demo-chaindata',
  'pikopay-demo-ask',
];

const TRANSFER_TYPES = {
  TransferWithAuthorization: [
    { name: 'from', type: 'address' },
    { name: 'to', type: 'address' },
    { name: 'value', type: 'uint256' },
    { name: 'validAfter', type: 'uint256' },
    { name: 'validBefore', type: 'uint256' },
    { name: 'nonce', type: 'bytes32' },
  ],
};

function resolveUrl(u) {
  if (/^https?:\/\//i.test(u)) return u;
  return GATEWAY.replace(/\/$/, '') + (u.startsWith('/') ? u : '/' + u);
}

function usd(units) {
  return (Number(units) / 1e6).toFixed(6).replace(/0+$/, '').replace(/\.$/, '.0');
}

// Fail fast: ethers' JsonRpcProvider retries network detection for a long
// time on a dead URL; race it so a bad RPC never hangs the CLI.
function withTimeout(promise, ms, label) {
  return Promise.race([
    promise,
    new Promise((_, rej) => setTimeout(() => rej(new Error(label + ' timeout')), ms)),
  ]);
}

function makeProvider(url) {
  // staticNetwork skips chain-id auto-detection (we know it: 2049).
  return new ethers.JsonRpcProvider(url, CHAIN_ID, { staticNetwork: true });
}

async function cmdDiscover() {
  let provider;
  let rpcUsed = RPC;
  try {
    provider = makeProvider(RPC);
    await withTimeout(provider.getBlockNumber(), 8000, 'local RPC');
  } catch (e) {
    // Portable fallback: the public gateway also serves JSON-RPC.
    try {
      provider = makeProvider(GATEWAY);
      await withTimeout(provider.getBlockNumber(), 12000, 'gateway RPC');
      rpcUsed = GATEWAY;
    } catch (e2) {
      console.log(JSON.stringify({
        ok: false, warning: `RPC unreachable (${RPC}, ${GATEWAY}); static fallback`,
      services: [{
        seed: 'pikopay-demo-insight', endpoint: `${GATEWAY}/x402/insight`,
        pricePerCall: '10000', priceUsd: '$0.01', note: 'demo, may be stale',
      }],
      }, null, 2));
      return;
    }
  }
  const reg = new ethers.Contract(REGISTRY,
    ['function get(bytes32 id) view returns (address owner, string endpoint, uint256 pricePerCall, address payTo, string meta, bool active)'],
    provider);
  const services = [];
  for (const seed of KNOWN_SEEDS) {
    const id = ethers.keccak256(ethers.toUtf8Bytes(seed));
    try {
      const [owner, endpoint, pricePerCall, payTo, meta, active] = await reg.get(id);
      if (owner === ethers.ZeroAddress) continue; // never registered
      services.push({ seed, id, owner, endpoint, pricePerCall: pricePerCall.toString(), priceUsd: '$' + usd(pricePerCall), payTo, meta, active });
    } catch { /* skip unreadable */ }
  }
  console.log(JSON.stringify({ ok: true, registry: REGISTRY, chainId: CHAIN_ID, rpc: rpcUsed, services }, null, 2));
}

async function fetchQuote(url) {
  const r = await fetch(resolveUrl(url));
  if (r.status === 200) return { free: true, status: 200, body: await r.json().catch(() => ({})) };
  if (r.status !== 402) throw new Error(`unexpected status ${r.status} (expected 402 or 200)`);
  const q = await r.json();
  const accepts = (q.accepts || []).map(a => ({
    network: a.network, scheme: a.scheme,
    maxAmountRequired: a.maxAmountRequired, priceUsd: '$' + usd(a.maxAmountRequired),
    payTo: a.payTo, asset: a.asset,
    feeBps: a.feeBps ?? 0, feeRecipient: a.feeRecipient ?? null,
    description: a.description,
  }));
  return { free: false, status: 402, accepts, raw: q };
}

async function cmdPrice(url) {
  console.log(JSON.stringify(await fetchQuote(url), null, 2));
}

async function cmdBounty(address) {
  if (!/^0x[0-9a-fA-F]{40}$/.test(address)) throw new Error('bounty: invalid address');
  const r = await fetch(GATEWAY.replace(/\/$/, '') + '/x402/bounty', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ address }),
  });
  const body = await r.json().catch(() => ({}));
  console.log(JSON.stringify({ status: r.status, ...body }, null, 2));
  if (r.status !== 200) process.exitCode = 1;
}

async function signAuth(signer, accept, value) {
  const now = Math.floor(Date.now() / 1000);
  const authorization = {
    from: await signer.getAddress(),
    to: accept.payTo,
    value: value.toString(),
    validAfter: (now - 60).toString(),
    validBefore: (now + 600).toString(),
    nonce: ethers.hexlify(ethers.randomBytes(32)),
  };
  const signature = await signer.signTypedData(
    { name: (accept.extra && accept.extra.name) || 'Wrapped USD Coin', version: (accept.extra && accept.extra.version) || '1', chainId: CHAIN_ID, verifyingContract: accept.asset },
    TRANSFER_TYPES, authorization);
  return { signature, authorization };
}

async function cmdPay(url, opts) {
  let signer, isNew = false;
  if (opts.newKey) {
    signer = ethers.Wallet.createRandom();
    isNew = true;
    const addr = await signer.getAddress();
    console.error(`[pay] new throwaway wallet: ${addr} (key kept in memory only)`);
    const br = await fetch(GATEWAY.replace(/\/$/, '') + '/x402/bounty', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ address: addr }),
    });
    if (br.status !== 200) throw new Error(`bounty claim failed: ${br.status} ${(await br.text()).slice(0, 120)}`);
    console.error('[pay] bounty claimed: $0.05 test wUSDC');
    await new Promise(r => setTimeout(r, 4000)); // let the mint settle
  } else {
    let key = process.env.PIKO_X402_KEY;
    if (!key && opts.keyFile) key = fs.readFileSync(opts.keyFile, 'utf8').trim();
    if (!key) throw new Error('pay: no key. Set PIKO_X402_KEY, use --key-file <path>, or --new-key.');
    signer = new ethers.Wallet(key);
  }

  const target = resolveUrl(url);
  const quote = await fetchQuote(target);
  if (quote.free) {
    console.log(JSON.stringify({ paid: false, status: 200, note: 'service is free, no payment needed', body: quote.body }, null, 2));
    return;
  }
  const accept = (quote.raw.accepts || []).find(a => a.network === NETWORK);
  if (!accept) throw new Error(`pay: no ${NETWORK} option offered`);
  const price = BigInt(accept.maxAmountRequired);
  if (!isNew && !opts.yes) {
    console.error(`[pay] quote: $${usd(price)} -> ${accept.payTo}. Re-run with --yes to confirm.`);
    process.exitCode = 2; return;
  }

  const { signature, authorization } = await signAuth(signer, accept, price);
  let payload = { x402Version: 1, scheme: 'exact', network: NETWORK, payload: { signature, authorization } };

  // Facilitator fee (only when the 402 advertises feeBps > 0): second EIP-3009 auth on top.
  const feeBps = Number(accept.feeBps || 0);
  if (feeBps > 0 && accept.feeRecipient) {
    const feeValue = (price * BigInt(feeBps)) / 10000n;
    const feeAuth = await signAuth(signer, { ...accept, payTo: accept.feeRecipient }, feeValue);
    payload = { paymentPayload: payload, feePayload: feeAuth };
    console.error(`[pay] facilitator fee: $${usd(feeValue)} (${feeBps} bps) -> ${accept.feeRecipient}`);
  }

  const r = await fetch(target, {
    headers: { 'X-PAYMENT': Buffer.from(JSON.stringify(payload)).toString('base64') },
  });
  const body = await r.json().catch(() => ({}));
  let tx = body.tx || body.transaction || null;
  try {
    const pr = r.headers.get('payment-response');
    if (pr && !tx) tx = JSON.parse(Buffer.from(pr, 'base64').toString('utf8')).txHash || null;
  } catch { /* ignore */ }
  console.log(JSON.stringify({
    paid: r.status === 200, status: r.status,
    priceUsd: '$' + usd(price), tx, body,
  }, null, 2));
  if (r.status !== 200) process.exitCode = 1;
}

async function main() {
  const args = process.argv.slice(2);
  const cmd = args[0];
  const opts = { yes: args.includes('--yes') || args.includes('-y'), newKey: args.includes('--new-key') };
  const kv = (flag) => { const i = args.indexOf(flag); return i >= 0 && args[i + 1] ? args[i + 1] : null; };
  opts.keyFile = kv('--key-file');
  try {
    if (cmd === 'discover') await cmdDiscover();
    else if (cmd === 'price' && args[1]) await cmdPrice(args[1]);
    else if (cmd === 'pay' && args[1]) await cmdPay(args[1], opts);
    else if (cmd === 'bounty' && args[1]) await cmdBounty(args[1]);
    else {
      console.error('usage: piko-x402 discover | price <url> | pay <url> [--yes] [--new-key] [--key-file <p>] | bounty <address>');
      process.exitCode = 1;
    }
  } catch (e) {
    console.error('error:', e.message);
    process.exitCode = 1;
  }
}
main();
